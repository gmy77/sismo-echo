      VALUE "ProductName", "FVG GRIB Monitor"
      VALUE "ProductVersion", "1.0.0.0"
      VALUE "LegalCopyright", "Copyright (C) 2026 Gimmy (gmy77). Tutti i diritti riservati."
      VALUE "OriginalFilename", "FVG-GribMonitor.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
